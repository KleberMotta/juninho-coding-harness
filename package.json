{
  "name": "@kleber.mottajr/juninho",
  "version": "2.0.0",
  "description": "Bootstrap the Agentic Coding Framework into any OpenCode project",
  "bin": {
    "juninho": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "validate": "tsx scripts/validate.ts",
    "test": "bun test evals/",
    "test:structural": "bun test evals/tests/structural/",
    "test:context": "bun test evals/tests/context/",
    "eval:benchmark": "node eval/runners/run-benchmark.js . eval/benchmarks/benchmark-v0.json",
    "eval:loop": "sh eval/runners/run-loop.sh",
    "eval:prepare-autoresearch": "node eval/runners/prepare-autoresearch-run.js . ../autoresearch"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "opencode",
    "agents",
    "framework",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/KleberMotta/juninho-coding-harness"
  },
  "bugs": {
    "url": "https://github.com/KleberMotta/juninho-coding-harness/issues"
  },
  "homepage": "https://github.com/KleberMotta/juninho-coding-harness#readme",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0"
  }
}
