{
  "version": "v0-heavy",
  "description": "Heavy benchmark covering bootstrap, representative features, and a combined story-level full-flow task.",
  "weights": {
    "successRate": 1000,
    "qualityRate": 200,
    "regressionRate": -80,
    "normalizedTime": -40,
    "normalizedCost": -20,
    "flakeRate": -30
  },
  "defaults": {
    "projectType": "node-generic",
    "trials": 1,
    "bootstrapTimeoutMs": 600000,
    "implementTimeoutMs": 540000,
    "commandTimeoutMs": 480000,
    "checkTimeoutMs": 900000,
    "unifyTimeoutMs": 900000,
    "expectedCommands": [
      "j.finish-setup",
      "j.spec",
      "j.plan",
      "j.implement",
      "j.check",
      "j.unify"
    ]
  },
  "repos": [
    {
      "id": "fixture-node-service",
      "kind": "fixture",
      "path": "eval/fixtures/node-service",
      "projectType": "node-generic"
    }
  ],
  "tasks": [
    {
      "id": "bootstrap-node-service",
      "repo": "fixture-node-service",
      "type": "bootstrap",
      "trials": 1,
      "prompt": "Bootstrap repository knowledge for this project using the canonical harness workflow.",
      "expect": {
        "filesExist": [
          "AGENTS.md",
          ".opencode/juninho-config.json",
          ".opencode/skill-map.json",
          "docs/domain/INDEX.md",
          "docs/principles/manifest"
        ]
      }
    },
    {
      "id": "full-flow-add-subtract",
      "repo": "fixture-node-service",
      "type": "full-flow",
      "trials": 1,
      "specPrompt": "Add a subtract operation to the tiny math service, expose it through the HTTP API, and add focused tests. Keep the existing style and naming conventions.",
      "expect": {
        "filesExist": [
          "src/math.js",
          "src/server.js",
          "test/math.test.js"
        ],
        "anyGlobExists": [
          "docs/specs/**/spec.md",
          "docs/specs/**/plan.md",
          "docs/specs/**/state/README.md",
          "docs/specs/**/state/check-review.md"
        ],
        "fileContains": [
          {
            "path": "src/math.js",
            "text": "subtract"
          },
          {
            "path": "src/server.js",
            "text": "subtract"
          },
          {
            "path": "test/math.test.js",
            "text": "subtract"
          }
        ],
        "commandsSucceed": [
          "npm test"
        ]
      }
    },
    {
      "id": "full-flow-validate-query-params",
      "repo": "fixture-node-service",
      "type": "full-flow",
      "trials": 1,
      "specPrompt": "Harden the tiny math HTTP API so invalid query params are rejected with a stable JSON error response instead of returning NaN. Cover both the shared parsing path and focused tests, keeping the current style and no new dependencies.",
      "expect": {
        "filesExist": [
          "src/server.js",
          "test/math.test.js",
          "test/server.test.js"
        ],
        "anyGlobExists": [
          "docs/specs/**/spec.md",
          "docs/specs/**/plan.md",
          "docs/specs/**/state/README.md",
          "docs/specs/**/state/check-review.md"
        ],
        "fileContains": [
          {
            "path": "src/server.js",
            "text": "400"
          },
          {
            "path": "src/server.js",
            "text": "parseNumbers"
          },
          {
            "path": "test/server.test.js",
            "text": "400"
          },
          {
            "path": "test/server.test.js",
            "text": "not_found"
          }
        ],
        "commandsSucceed": [
          "npm test"
        ]
      }
    },
    {
      "id": "full-flow-subtract-and-validate",
      "repo": "fixture-node-service",
      "type": "full-flow",
      "trials": 1,
      "specPrompt": "Extend the tiny math HTTP API by adding a subtract operation and harden both arithmetic endpoints so invalid query params return a stable 400 JSON error instead of returning NaN. Add focused tests, keep the current style, and avoid new dependencies.",
      "expect": {
        "filesExist": [
          "src/math.js",
          "src/server.js",
          "test/math.test.js",
          "test/server.test.js"
        ],
        "anyGlobExists": [
          "docs/specs/**/spec.md",
          "docs/specs/**/plan.md",
          "docs/specs/**/state/README.md",
          "docs/specs/**/state/check-review.md"
        ],
        "fileContains": [
          {
            "path": "src/math.js",
            "text": "subtract"
          },
          {
            "path": "src/server.js",
            "text": "subtract"
          },
          {
            "path": "src/server.js",
            "text": "400"
          },
          {
            "path": "test/server.test.js",
            "text": "subtract"
          },
          {
            "path": "test/server.test.js",
            "text": "400"
          },
          {
            "path": "test/server.test.js",
            "text": "not_found"
          }
        ],
        "commandsSucceed": [
          "npm test"
        ]
      }
    }
  ]
}
